@model AccountFormViewModel
@{
    ViewData["Title"] = "Edit Account";
}

<h1>Edit Account</h1>
<hr />
<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Version" />
            <partial name="_AccountForm" model="Model" />
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Details</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
