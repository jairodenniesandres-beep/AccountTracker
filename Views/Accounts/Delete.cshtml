@model GmailAccount
@{
    ViewData["Title"] = "Delete Account";
}

<h1>Delete Account</h1>
<h4>Are you sure you want to delete this account record?</h4>
<p class="text-muted">This only removes it from AccountTracker - nothing happens to the Gmail account itself.</p>
<hr />
<div class="row">
    <div class="col-lg-8">
        <partial name="_AccountSummary" model="Model" />
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>
